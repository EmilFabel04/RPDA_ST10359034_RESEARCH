  "scenario_id": "NR02",
  "category": "null_rate_anomaly",
  "title": "Refactor removed coalesce on fct_orders.amount",
  "root_cause_type": "code",
  "root_cause": "A refactor commit removed coalesce(..., 0) from fct_orders.amount, so orders without payments (cancelled orders) now have a NULL amount.",
  "fault": {
    "kind": "code",
    "diff": "--- a/models/marts/fct_orders.sql\n+++ b/models/marts/fct_orders.sql\n@@ -35,7 +35,7 @@\n         coalesce(order_payments.bank_transfer_amount, 0) as bank_transfer_amount,\n         coalesce(order_payments.voucher_amount, 0) as voucher_amount,\n         coalesce(order_payments.gift_card_amount, 0) as gift_card_amount,\n-        coalesce(order_payments.total_amount, 0) as amount\n+        order_payments.total_amount as amount\n     from orders\n     left join order_payments on orders.order_id = order_payments.order_id\n \n",
    "data_change": null,
    "facts": {
      "as_of": "2026-10-13 19:00 UTC",
      "n_customers": 200,
      "n_orders": 600,
      "n_payments": 636,
      "hist_orders": "584, 587, 590, 594, 594, 597",
      "hist_customers": "194, 194, 195, 195, 196, 198",
      "n_null": 46,
      "age_raw_customers": "4",
      "age_raw_orders": "1",
      "age_raw_payments": "1"
    }
  },
