# Secrets — never commit
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/
.idea/

# dbt build outputs (regenerated by `dbt build`)
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
logs/

# DuckDB database files (regenerated from seeds)
*.duckdb
*.duckdb.wal

# Scratch working copies made by inject_failure.py
tmp/

# generated by core/seed_data.py on every build (timestamps are relative to now)
dbt_project/seeds/*.csv

# run_experiment.py's lock file (stops two runs at once)
results/.run.lock

# analysis built from MOCK scores (regenerate with: python scripts/analyse.py --mock)
results/mock/analysis/
results/mock/figures/

# report build dependencies
report/node_modules/
report/package-lock.json

# Word lock files while a document is open
~$*
_finalise.docx
_compare_user.docx
_compare_fixed.docx
_word_backup*.docx
