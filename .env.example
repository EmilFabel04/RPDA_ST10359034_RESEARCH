# Copy this file to .env and fill in your keys:   cp .env.example .env
# NEVER commit .env (it is listed in .gitignore).

# ---------------------------------------------------------------- API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Pinned model IDs
# Verified against provider docs on 2026-10-12. Every call also logs the model
# version string the API actually returned, so drift would be visible in the data.

# OpenAI GPT-5-class: dated snapshot of GPT-5.5 (a dated snapshot never changes).
OPENAI_MODEL_ID=gpt-5.5-2026-04-23

# Anthropic Sonnet: current Sonnet. Anthropic no longer publishes dated suffixes
# for current models; this ID is the pinned version.
ANTHROPIC_MODEL_ID=claude-sonnet-5-5

# Local model via Ollama. The exact build (model digest) is logged at call time.
OLLAMA_MODEL=llama3:8b
OLLAMA_HOST=http://localhost:11434
# llama3:8b's maximum context window is 8192 tokens. Ollama's default is smaller
# and truncates long prompts SILENTLY, so we always pass num_ctx explicitly.
OLLAMA_NUM_CTX=8192

# ---------------------------------------------------------------- Generation settings
# Identical for all three models. See docs/decisions_log.md for why 1.0 (not 0.7).
TEMPERATURE=1.0
MAX_OUTPUT_TOKENS=2048

# Reasoning/thinking set to the lowest setting on both cloud models, so all three
# models answer directly (llama3:8b has no reasoning mode). See decisions log.
OPENAI_REASONING_EFFORT=none
ANTHROPIC_THINKING=between_tools

# ---------------------------------------------------------------- Reproducibility
GLOBAL_SEED=42
